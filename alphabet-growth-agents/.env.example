ANTHROPIC_API_KEY=sk-ant-your-key-here

# Reddit API (required for live posts)
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USERNAME=your-reddit-username
REDDIT_PASSWORD=your-reddit-password

# How far back to look for posts (in hours)
MAX_POST_AGE_HOURS=48

# Email settings (Gmail) — leave blank to skip email and print to console only
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=faramarza@gmail.com
SMTP_PASS=your-gmail-app-password
RECIPIENT_EMAIL=faramarza@gmail.com
