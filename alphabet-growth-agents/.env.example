ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Search Backend ─────────────────────────────────
# Serper.dev API key (Google Search results)
# Get one at https://serper.dev — 2,500 free queries
# If set, uses Serper instead of DuckDuckGo (which blocks VPS IPs)
SERPER_API_KEY=

# ── Source toggles ──────────────────────────────────
REDDIT_ENABLED=false
GOOGLE_ENABLED=true
QUORA_ENABLED=true
PINTEREST_ENABLED=true

# ── Reddit API (disabled until approved) ────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# How far back to look for posts (in hours)
MAX_POST_AGE_HOURS=48

# ── Google Search Console ───────────────────────
# Path to service account JSON key file
GSC_SERVICE_ACCOUNT_KEY=
# GSC property (default: sc-domain:alphabet-trains.com)
GSC_SITE_URL=sc-domain:alphabet-trains.com

# ── Ahrefs CSV Exports ──────────────────────────
# Folder path where you drop Ahrefs CSV exports
# Expected files: keyword-gap*.csv, backlink*.csv
AHREFS_CSV_FOLDER=

# ── Magento ─────────────────────────────────────
# Mode: "export" (default) reads a JSON file, "replica" queries a read replica
MAGENTO_MODE=export

# Export mode: path to the JSON file generated by the Magento cron job
MAGENTO_EXPORT_PATH=

# Replica mode: read-only MySQL connection to a read replica
# NEVER point this at the primary DB during business hours
MAGENTO_DB_HOST=
MAGENTO_DB_PORT=3306
MAGENTO_DB_USER=
MAGENTO_DB_PASSWORD=
MAGENTO_DB_NAME=
MAGENTO_QUERY_TIMEOUT=30000

# ── Site Context Cache ──────────────────────────
# How long to cache site context before re-fetching (hours)
SITE_CONTEXT_CACHE_HOURS=12

# ── Email (Gmail) ─────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=faramarza@gmail.com
SMTP_PASS=your-gmail-app-password
RECIPIENT_EMAIL=faramarza@gmail.com

# ── Dashboard ───────────────────────────────────
DASHBOARD_PORT=3456
