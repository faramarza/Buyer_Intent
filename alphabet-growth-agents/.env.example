ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Source toggles ──────────────────────────────
# Google, Quora, Pinterest work immediately (no API keys needed)
# Reddit requires API approval — leave false until approved
REDDIT_ENABLED=false
GOOGLE_ENABLED=true
QUORA_ENABLED=true
PINTEREST_ENABLED=true

# ── Reddit API (disabled until approved) ────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# How far back to look for posts (in hours)
MAX_POST_AGE_HOURS=48

# ── Email (Gmail) ───────────────────────────────
# Leave blank to skip email and print to console only
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=faramarza@gmail.com
SMTP_PASS=your-gmail-app-password
RECIPIENT_EMAIL=faramarza@gmail.com
